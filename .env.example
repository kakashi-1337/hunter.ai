# Copy this file to .env and fill in what you use. .env is ignored by git: never commit it.
# Only a model to talk to is required: one key below, Ollama running with a chat model, or a
# colibri server with its address below.

# --- Models (any one is enough) ---------------------------------------------------------
ABLIT_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
# Ollama, when it is not at http://127.0.0.1:11434
# OLLAMA_HOST=
# The context window every call to a local model gets, in tokens (Settings writes it here too).
# More keeps more of a long chat and needs more memory: about 1 GB per 8,000 tokens with an 8B model.
# HUNTERAI_OLLAMA_NUM_CTX=16384
# colibri (github.com/JustVugg/colibri), for models larger than this machine's memory: the address its
# setup prints as the OpenAI base URL (Settings writes it here too). Empty: colibri is not used.
# HUNTERAI_COLIBRI_URL=http://127.0.0.1:8000
# Its key, only when colibri was started with one (COLI_API_KEY).
# COLIBRI_API_KEY=

# --- Optional services ------------------------------------------------------------------
# Profundis (internet-wide scan data): the `profundis` tool appears when this is set.
PROFUNDIS_API_KEY=
# A free NVD key raises the rate limit of the `cve` tool. It works without one.
NVD_API_KEY=
# A Discord webhook address: positive findings are announced there (never their evidence).
DISCORD_WEBHOOK_URL=

# A proxy the model providers are reached through (Settings writes it here too). Not the
# proxy for your targets: that one is set under Settings, Proxy, or in a target.
# HUNTERAI_PROVIDER_PROXY=http://user:password@host:port

# --- Settings (all optional; the defaults are in the README) -----------------------------
# HUNTERAI_PORT=8790
# HUNTERAI_MAX_CPU_TEMP=90        # embedding and look_at_image wait above this; "off" disables
# HUNTERAI_CAIDO=off              # never start or use Caido
# HUNTERAI_PRIVATE_ENV=MYTOOL_,INTERNAL_   # prefixes of other tools' variables to keep from commands
# HUNTERAI_ACTIVITY_LOG=off       # do not write ~/.hunterai/logs/activity.jsonl
# HUNTERAI_PROXY_TEST_URL=https://www.cloudflare.com/cdn-cgi/trace   # the page(s) the proxy test asks
